# Captures may contain private values and controller projection signing keys.
# Existing fixture captures stay tracked; command/log records stay local.
.etiq/
**/controller/catalogue.json
# Compressed audit/test archives can embed private catalogues and runtime auth.
/evidence/**/*.zip
# User-selected local-only pilot results (implementation stays versioned).
/evidence/laya-pilot-*/

# Generated internal QA records stay local; retain Python validation helpers.
**/evidence/*-tester-*/
**/evidence/validation-*/*
!**/evidence/validation-*/*.py
# These capture records describe local command execution, not fixture contents.
**/.etiq/**/command.json
**/.etiq/**/*.log

# Local working copies, publication exports and downloaded model/package caches
instructions_between_agents/
.tmp/
/publish-ready/
/pilots/laya/cache/
/pilots/laya/wheels/
.cache/
.huggingface/
.ollama/

